# Backend Environment Configuration Example
# Copy this file to backend/.env and configure only the providers you want to use.
# Never commit backend/.env or real API keys to Git.

APP_NAME=LabXAI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./labxai.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1. OpenRouter Cloud AI (optional, kept strictly server-side)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_SITE_URL=http://localhost:5173

# 2. Lightweight Local LLM (optional — no Ollama required; auto-detects if installed)
# Recommended quantized GGUF model for 4GB VRAM / 12GB RAM laptops:
# Qwen2.5-1.5B-Instruct-Q4_K_M.gguf (~1.1 GB disk, ~1.8 GB RAM on CPU)
LOCAL_LLM_ENABLED=auto
LOCAL_LLM_BACKEND=auto
LOCAL_LLM_MODEL_PATH=
LOCAL_LLM_SERVER_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL_NAME=Qwen2.5-1.5B-Instruct-Q4_K_M
LOCAL_LLM_N_CTX=2048
LOCAL_LLM_N_GPU_LAYERS=0
LOCAL_LLM_THREADS=6
LOCAL_LLM_TIMEOUT_SECONDS=45

# 3. Independent Backend Regional Text-to-Speech (EN, KN, HI, TA, TE)
# Supported providers: edge (zero-credential Microsoft Neural voices), sarvam, azure, google, disabled
TTS_PROVIDER=edge
TTS_API_KEY=
TTS_REGION=centralindia
TTS_MODEL=bulbul:v2
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_KN=kn-IN-SapnaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_TA=ta-IN-PallaviNeural
TTS_VOICE_TE=te-IN-ShrutiNeural
TTS_MAX_TEXT_CHARS=2500
TTS_TIMEOUT_SECONDS=20
TTS_CACHE_TTL_HOURS=24
